generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  posts        Post[]
  following    String[] @default([]) @db.ObjectId
  followers    String[] @default([]) @db.ObjectId
}

model Post {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  caption    String
  imageUrl   String?
  authorId   String     @db.ObjectId
  author     User       @relation(fields: [authorId], references: [id])
  comments   Comment[]
  likedBy    String[]   @db.ObjectId
  visibility Visibility @default(PUBLIC)
  editedAt   DateTime?
  createdAt  DateTime   @default(now())
}

enum Visibility {
  PUBLIC     // vijda go vseki
  FOLLOWERS  // samo horata, koito sledvat avtora
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  userId      String           @db.ObjectId // poluchatelyat
  type        NotificationType
  actorId     String           @db.ObjectId // koy e izvurshil deystvieto
  actorName   String                        // dublirame imeto i snimkata,
  actorAvatar String?                       // za da ne durpame potrebitelya pri vseki red
  postId      String?          @db.ObjectId
  excerpt     String?                       // otkus ot komentara
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
}

type Comment {
  authorId   String   @db.ObjectId
  authorName String
  text       String
  createdAt  DateTime @default(now())
}